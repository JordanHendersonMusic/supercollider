/*

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Some notes about this file.
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Bison is a LALR bottom-up parser, it is quite old technology and can be hard to use.
LALR is quite difficult to write compared to more modern approaches, but it will produce reduce-shift conflicts if you make a mistake. 
There should be *no* warnings when generating the final parser.

Bottom-up parsing means that the parts of the rule are parsed before the rule itself. All the child nodes are produced *before* the parent. 
This is in stark contrast to other types of parsing, like recursive descent.

This grammar was made in the early 2000s and is showing its age. 
For example, there is a lot of duplication here, particularly regarding the 'msgsend' rule.
This has grown naturally as the language has evolved and could use a refactor, however, changing this requires some form of fuzz testing to ensure compatibility is maintained.
While taking previously invalid syntax and making it valid is generally okay, refactoring existing syntax must be thoroughly tested.

If you are looking at documentation on Bison you will often see it accompanied with Flex, that part is not relevant to understanding this file — although it can be useful.


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Some notes relationship between the lexer and the parser.
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Bison uses global variables everywhere, again, this is because of its age.
We do not support having multiple instances of the parser at once (this is a feature in modern Bison), therefore no multithreading.

The lexer's job is to define a function called yylex.

It produces an int, which is an enum (weakly typed) of the type yytokentype, which can be found in the generated header.
yytokentype, being backed by an integer, can contain all utf8 characters, along with all the special %tokens declared below.

Additionally, yylex writes to several globals used to communicate with the parser.

yylval:

This is a union of type YYSTYPE and contains any produced data.
For example, if tokenizing a double, the lexer could turn the text into a double and write the result there.
YYSTYPE is defined below with the %union statement.

yylloc:

This is the location in the source file of the token. 


It is recommended to read a basic introduction to bison before proceeding, but for ease of understanding:

yyval is accessed in each rule by using '$N' and $$, where 'N' refers to the index of the child rule, and '$$' is the produced value.
Note, '$$' is the field of the union, not the union itself, Bison will automatically deduce which field you should be writing to by looking at the %type statement for that rule.

yyloc is accessed in each by using @$ and @N. Most of the time, this isn't necessary as bison will automatically figure out the correct location info for you.

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Some notes on memory
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

All PyrParseNodes are created using an arena allocator. 
We do not use bison's destructor feature.
You don't have to worry about memory here in this file, but when using the lexer and parser there is additional setup and tear-down required.

*/

%{

// Preamble for the generated source file.

#include <stdlib.h>
#include <string.h>
#include "bisonHeaderInclude.hpp"
#include "PyrLexer.h"
#include "PyrParseNode.h"
#include "SC_Constants.h"
#include "SC_InlineUnaryOp.h"
#include "SC_InlineBinaryOp.h"
#include "InitAlloc.h"
#include "PredefinedSymbols.h"
#include "SimpleStack.h"

int yyparse();
extern LongStack generatorStack;

%}

%define parse.error verbose

// This union will become YYSTYPE. 
// It is what each rule and token produces. 
// Which field is active is determined by the %type <field> statement or %token <field>. 
// The lexer can write to this through yylval, and the parser (this file) can access this by reading from $N and writing to $$.

// NOTE: there is a correcsponding YYSTypeTag enum providing the tags for this union, please keep it updated.
%union { 
	struct PyrParseNode* node;  // Base class.
	struct PyrSlotNode* slotNode; // For some literal value
	struct PyrVarListNode* varListNode;
	struct PyrVarDefNode* varDefNode;
	struct PyrMethodNode* methodNode;
	struct PyrArgListNode* argListNode;
	struct PyrMultiAssignVarListNode* multiAssignListNode;
	ReadWriteAccessor rwAccessor;
	EmptyYYVal empty;
}

// Enable yyloc and the use of @N to access the source code location struct.
%locations
%define api.location.type {Location}

// List of tokens, these are turned into an enum which can be accessed in PyrLexer.
// These produce a slotNode, and the following produce an empty.
%token <slotNode> NAME INTEGER SC_FLOAT ACCIDENTAL SYMBOL STRING ASCII CLASSNAME PIE WHILE PRIMITIVENAME LEFTARROW TRUEOBJ FALSEOBJ NILOBJ PSEUDOVAR
%token <empty> VAR ARG CLASSVAR SC_CONST ELLIPSIS DOTDOT BEGINCLOSEDFUNC BADTOKEN INTERPRET BEGINGENERATOR CURRYARG


// TOKEN PRECEDENCE
// Note that the order these are declared in matters greatly.

%left ':'
%right '='
%left <slotNode> BINOP KEYBINOP '-' '<' '>' '*' '+' '|' READWRITEVAR
%left '.'
%right '`'
%right UMINUS


// Defines what field each rule will produce in the union yylval.
// This allows type checking in the parser!

%type <rwAccessor> rspec rwspec 

%type <slotNode> floatp floatr integer accidental name binop binop2 optName optSuperName optPrim nameList

%type <varListNode> classvardecls classvardecl funcvardecls funcvardecl funcvardecls1

%type <varDefNode> rwslotdef rwslotdeflist constdeflist constdef vardef vardeflist vardeflist0 slotdef slotdeflist slotdeflist0

%type <methodNode> methoddef methods

%type <argListNode> argdecls argdecls1

%type <multiAssignListNode> mavars

%type <node> listlit2 literallistc listlit root classes classextensions classextension 
%type <node> classdef generator qual nextqual expr expr1 exprn exprseq arrayelems arrayelems1 arglist1 arglistv1 keyarglist1 
%type <node> keyarg optkeyarglist valrangex1 valrangeassign valrangexd literallist1 funcbody cmdlinecode funretval pushliteral
%type <node> blockliteral pushname msgsend adverb dictslotlist retval blocklist1 blocklist valrange2 valrange3
%type <node> slotliteral listliteral block methbody dictslotdef dictslotlist1 blocklistitem curryArg

%start root

%%
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Begin parser rules
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


root			: classes
					{ 
						$$ = gRootParseNode = $1;
					}
				| classextensions
					{ 
						$$ = gRootParseNode = $1;
					}
				| INTERPRET cmdlinecode
					{ 
						$$ = gRootParseNode = $2;
					};

classes 		: %empty { $$ = nullptr; }
				| classes classdef 
					{ $$ = linkNodes($1, $2); };

classextensions : classextension
				| classextensions classextension
					{ $$ = linkNodes($1, $2); };

classdef		: CLASSNAME optSuperName '{' classvardecls methods '}'
					{ $$ = allocParseNode<PyrClassNode>(@$, $1, $2, nullptr, $4, $5); }
				| CLASSNAME '[' optName ']' optSuperName '{' classvardecls methods '}'
					{ $$ = allocParseNode<PyrClassNode>(@$, $1, $5, $3, $7, $8); };

classextension 	: '+' CLASSNAME '{' methods '}'
					{ $$ = allocParseNode<PyrClassExtNode>(@$, $2, $4); };

optName			: %empty { $$ = nullptr; } | name;

// Note the inclusion of the colon here.
optSuperName	: %empty { $$ = nullptr; } | ':' CLASSNAME { $$ = $2; };

classvardecls	: %empty { $$ = nullptr; }
				| classvardecls classvardecl
					{ $$ = linkNodes($1, $2); };

classvardecl	: CLASSVAR rwslotdeflist ';'
					{ $$ = allocParseNode<PyrVarListNode>(@$, $2, varClass); }
				| VAR rwslotdeflist ';'
					{ $$ = allocParseNode<PyrVarListNode>(@$, $2, varInst); }
				| SC_CONST constdeflist ';'
					{ $$ = allocParseNode<PyrVarListNode>(@$, $2, varConst); };

methods			: %empty { $$ = nullptr; }
				| methods methoddef
					{ $$ = linkNodes($1, $2); };

methoddef		: name '{' argdecls funcvardecls optPrim methbody '}'
					{ $$ = allocParseNode<PyrMethodNode>(@$, $1, $5, $3, $4, $6, false); }
				| '*' name '{' argdecls funcvardecls optPrim methbody '}'
					{ $$ = allocParseNode<PyrMethodNode>(@$, $2, $6, $4, $5, $7, true); }
				| binop '{' argdecls funcvardecls optPrim methbody '}'
					{ $$ = allocParseNode<PyrMethodNode>(@$, $1, $5, $3, $4, $6, false); }
				| '*' binop '{' argdecls funcvardecls optPrim methbody '}'
					{ $$ = allocParseNode<PyrMethodNode>(@$, $2, $6, $4, $5, $7, true); };

optsemi		 	: %empty | ';';
optcomma		: %empty | ',';
optequal		: %empty | '=';

funcbody		: funretval
				| exprseq funretval
					{ $$ = allocParseNode<PyrDropNode>(@$, $1, $2); };

cmdlinecode		: '(' argdecls1 funcvardecls1 funcbody ')'
					{ $$ = allocParseNode<PyrBlockNode>(@$, $2, $3, $4, false); }
				| '(' argdecls1 funcbody ')'
					{ $$ = allocParseNode<PyrBlockNode>(@$, $2, nullptr, $3, false); }
				| '(' funcvardecls1 funcbody ')'
					{ $$ = allocParseNode<PyrBlockNode>(@$, nullptr, $2, $3, false); }
				| argdecls1 funcvardecls1 funcbody
					{ $$ = allocParseNode<PyrBlockNode>(@$, $1, $2, $3, false); }
				| argdecls1 funcbody
					{ $$ = allocParseNode<PyrBlockNode>(@$, $1, nullptr, $2, false); }
				| funcvardecls1 funcbody
					{ $$ = allocParseNode<PyrBlockNode>(@$, nullptr, $1, $2, false); }
				| funcbody
					{ $$ = allocParseNode<PyrBlockNode>(@$, nullptr, nullptr, $1, false); };

methbody		: retval
				| exprseq retval
					{ $$ = allocParseNode<PyrDropNode>(@$, $1, $2); };

optPrim	: 		%empty  { $$ = nullptr; }
				| PRIMITIVENAME optsemi { $$ = $1; };

retval			: %empty { $$ = allocParseNode<PyrReturnNode>(@$, nullptr); }
				| '^' expr optsemi
					{ $$ = allocParseNode<PyrReturnNode>(@$, $2); };

funretval		: %empty
					{ $$ = allocParseNode<PyrBlockReturnNode>(@$, nullptr); }
				| '^' expr optsemi
					{ $$ = allocParseNode<PyrReturnNode>(@$, $2); };

blocklist1		: blocklistitem
				| blocklist1 blocklistitem
					{ $$ = linkNodes($1, $2); };

blocklistitem 	: blockliteral | generator;

blocklist		: %empty { $$ = nullptr; } | blocklist1;

msgsend 		: name blocklist1
					{ $$ = allocParseNode<PyrCallNode>(@$, $1, $2, nullptr); }
				
				| '(' binop2 ')' blocklist1
					{ $$ = allocParseNode<PyrCallNode>(@$, $2, $4, nullptr); }

				| name '(' ')' blocklist1
					{ $$ = allocParseNode<PyrCallNode>(@$, $1, $4, nullptr); }

				| name '(' arglist1 optkeyarglist ')' blocklist
					{ $$ = allocParseNode<PyrCallNode>(@$, $1, linkNodes($3, $6), $4); }

				| '(' binop2 ')' '(' ')' blocklist1
					{ $$ = allocParseNode<PyrCallNode>(@$, $2, $6, nullptr); }

				| '(' binop2 ')' '(' arglist1 optkeyarglist ')' blocklist
					{ $$ = allocParseNode<PyrCallNode>(@$, $2, linkNodes($5, $8), $6); }

				| name '(' arglistv1 optkeyarglist ')'
					{
						PyrSlot selector;
						// Is the keyword 'super' in 'msg(super, *[])'.
						if (isSuperObjNode($3)) {
							auto* slot_node = node_cast<PyrSlotNode>($3);
							slot_node->mSlot = PyrSlot::make(s_this);
							selector = PyrSlot::make(s_superPerformList);
						} else {
							selector = PyrSlot::make(s_performList);
						}
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, selector);
						auto* args = linkAfterHead($3, $1->changeLiteralType<PyrParseNodeType::PushLitNode>());
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, args, $4);
					}
				| '(' binop2 ')' '(' arglistv1 optkeyarglist ')'
					{
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_performList));
						auto* args = linkAfterHead($5, $2->changeLiteralType<PyrParseNodeType::PushLitNode>());
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, args, $6);
					}
				| CLASSNAME '[' arrayelems ']'
					{ $$ = allocParseNode<PyrDynListNode>(@$, $1, $3); }

				| CLASSNAME blocklist1
					{
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_new));
						auto* args = linkNodes($1->changeLiteralType<PyrParseNodeType::PushNameNode>(), $2);
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, args, nullptr);
					}
				| CLASSNAME '(' ')' blocklist
					{
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_new));
						auto* args = linkNodes($1->changeLiteralType<PyrParseNodeType::PushNameNode>(), $4);
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, args, nullptr);
					}
				| CLASSNAME '(' keyarglist1 optcomma ')' blocklist
					{
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_new));
						auto* args = linkNodes($1->changeLiteralType<PyrParseNodeType::PushNameNode>(), $6);
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, args, $3);
					}
				| CLASSNAME '(' arglist1 optkeyarglist ')' blocklist
					{
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_new));
						auto* args = linkNodes(
							$1->changeLiteralType<PyrParseNodeType::PushNameNode>(), 
							$3,
							$6);
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, args, $4);
					}
				| CLASSNAME '(' arglistv1 optkeyarglist ')'
					{
						PyrSlot selector;
						if (isSuperObjNode($1)) {
							// Ehh? this is not possible. CLASSNAME cannot be 'super'.
							$1->mSlot = PyrSlot::make(s_this);
							selector = PyrSlot::make(s_superPerformList);
						} else {
							selector = PyrSlot::make(s_performList);
						}

						auto* new_selector_push_lit = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_new), PyrParseNodeType::PushLitNode);
						auto* args = linkNodes(
							$1->changeLiteralType<PyrParseNodeType::PushNameNode>(),
							new_selector_push_lit,
							$3
						);
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, selector);
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, args, $4);
					}
				| expr '.' '(' ')' blocklist
					{
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_value));
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, linkNodes($1, $5), nullptr);
					}
				| expr '.' '(' keyarglist1 optcomma ')' blocklist
					{
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_value));
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, linkNodes($1, $7), $4);
					}
				| expr '.' name '(' keyarglist1 optcomma ')' blocklist
					{ $$ = allocParseNode<PyrCallNode>(@$, $3, linkNodes($1, $8), $5); }
				| expr '.' '(' arglist1 optkeyarglist ')' blocklist
					{
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_value));
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, linkNodes($1, $4, $7), $5);
					}
				| expr '.' '(' arglistv1 optkeyarglist ')'
					{
						PyrSlot selectorSlot;
						if (isSuperObjNode($1)) {
							node_cast<PyrSlotNode>($1)->mSlot = PyrSlot::make(s_this);
							selectorSlot = PyrSlot::make(s_superPerformList);
						} else {
							selectorSlot = PyrSlot::make(s_performList);
						}
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, selectorSlot);
						auto* args = linkNodes(
							$1, 
							allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_value), PyrParseNodeType::PushLitNode),
							$4);
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, args, $5);
					}
				| expr '.' name '(' ')' blocklist
					{ $$ = allocParseNode<PyrCallNode>(@$, $3, linkNodes($1, $6), nullptr); }
				| expr '.' name '(' arglist1 optkeyarglist ')' blocklist
					{ $$ = allocParseNode<PyrCallNode>(@$, $3, linkNodes($1, $5, $8), $6); }
				| expr '.' name '(' arglistv1 optkeyarglist ')'
					{
						PyrSlot slot;
						if (isSuperObjNode($1)) {
							node_cast<PyrSlotNode>($1)->mSlot = PyrSlot::make(s_this);
							slot = PyrSlot::make(s_superPerformList);
						} else {
							slot = PyrSlot::make(s_performList);
						}
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, slot);
						auto* args = linkNodes($1, $3->changeLiteralType<PyrParseNodeType::PushLitNode>(), $5);
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, args, $6);
					}
				| expr '.' name blocklist
					{ $$ = allocParseNode<PyrCallNode>(@$, $3, linkNodes($1, $4), nullptr); } ;



// This section is for list comprehension/generators. 
// It uses the generatorStack and I do not know how it works. 
// In future, it would be good to create some documentation for this.
// For now, the code is left as it is.
generator 		: '{' ':' exprseq { pushls(&generatorStack, (intptr_t)$3); pushls(&generatorStack, 1); } ',' qual '}'
					{
						PyrSlotNode* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(getsym("r")));
						PyrParseNode *block = allocParseNode<PyrBlockNode>(@$, nullptr, nullptr, $6, false);
						PyrParseNode *blocklit = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(static_cast<void*>(block)), PyrParseNodeType::PushLitNode);
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, blocklit, nullptr);
					}
				| '{' ';' exprseq { pushls(&generatorStack, (intptr_t)$3); pushls(&generatorStack, 2); } ',' qual '}'
					{ $$ = $6; };

nextqual		: %empty
					{
						// innermost part
						const int action = popls(&generatorStack);
						auto* expr = (PyrParseNode*)popls(&generatorStack);
						if (action == 1) 
							$$ = allocParseNode<PyrCallNode>(@$, allocParseNode<PyrSlotNode>(@$, PyrSlot::make(getsym("yield"))), expr, nullptr);
						else if (action == 2)
							$$ = expr; 
						// if action is neither, then what?
					}
				| ',' qual { $$ = $2; };

qual			: name LEFTARROW exprseq nextqual
					{
						// later should check if exprseq is a series and optimize it to for loop
						
						auto* var = allocParseNode<PyrVarDefNode>(@1, $1, nullptr, ReadWriteAccessor::Private);
						auto* args = allocParseNode<PyrArgListNode>(@1, var, nullptr, nullptr);
						auto *block = allocParseNode<PyrBlockNode>(@1, args, nullptr, $4, false);
						auto *blocklit = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(static_cast<void*>(block)), PyrParseNodeType::PushLitNode);
						if (auto* call = node_cast<PyrCallNode>($3); call && call->mSelector->mSlot.getSymbol() == s_series) {
								call->mSelector->mSlot = PyrSlot::make(getsym("forSeries"));
								call->mArglist = linkNodes(call->mArglist, blocklit);
								$$ = call;
						} else {
							auto* selectornode = allocParseNode<PyrSlotNode>(@3, PyrSlot::make(getsym("do")));
							$$ = allocParseNode<PyrCallNode>(@$, selectornode, linkNodes($3, blocklit), nullptr);
						}
					}
				| name name LEFTARROW exprseq nextqual
					{
						auto* call = node_cast<PyrCallNode>($4);
						const auto is_series = call ? (call->mSelector->mSlot.getSymbol() == s_series) : false;

						auto* var1 = allocParseNode<PyrVarDefNode>(@$, $1, nullptr, ReadWriteAccessor::Private);
						auto* var2 = allocParseNode<PyrVarDefNode>(@$, $2, nullptr, ReadWriteAccessor::Private);
						auto* args = allocParseNode<PyrArgListNode>(@$, linkNodes(var1, var2), nullptr, nullptr);
						auto *block = allocParseNode<PyrBlockNode>(@$, args, nullptr, $5, false);
						auto *blocklit = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(static_cast<void*>(block)), PyrParseNodeType::PushLitNode);

						if (auto* call = node_cast<PyrCallNode>($3); call && call->mSelector->mSlot.getSymbol() == s_series) {
							call->mSelector->mSlot = PyrSlot::make(getsym("forSeries"));
							call->mArglist = linkNodes(call->mArglist, blocklit);
							$$ = call;
						} else {
							auto* selectornode = allocParseNode<PyrSlotNode>(@3, PyrSlot::make(getsym("do")));
							$$ = allocParseNode<PyrCallNode>(@$, selectornode, linkNodes($4, blocklit), nullptr);
						}
					}
				| VAR name '=' exprseq nextqual
					{
						PyrSlot slot = PyrSlot::make(s_value);
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, slot);
						auto* var = allocParseNode<PyrVarDefNode>(@$, $2, nullptr, ReadWriteAccessor::Private);
						auto* args = allocParseNode<PyrArgListNode>(@$, var, nullptr, nullptr);
						auto *block = allocParseNode<PyrBlockNode>(@$, args, nullptr, $5, false);
						auto *blocklit = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(static_cast<void*>(block)), PyrParseNodeType::PushLitNode);
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, linkNodes(blocklit, $4), nullptr);
					}
				| exprseq nextqual
					{
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(getsym("if")));
						auto* block = allocParseNode<PyrBlockNode>(@$, nullptr, nullptr, $2, false);
						auto* blocklit = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(static_cast<void*>(block)), PyrParseNodeType::PushLitNode);
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, linkNodes($1, blocklit), nullptr);
					}
				| ':' ':' exprseq nextqual
					{ $$ = allocParseNode<PyrDropNode>(@$, $3, $4); }
				| ':' WHILE exprseq nextqual
					{
						auto* selectornode1 = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(getsym("alwaysYield")));
						auto* pushnil = allocParseNode<PyrSlotNode>(@$, PyrSlot{}, PyrParseNodeType::PushLitNode);
						auto* yieldNil = allocParseNode<PyrCallNode>(@$, selectornode1, pushnil, nullptr);
						auto* block1 = allocParseNode<PyrBlockNode>(@$, nullptr, nullptr, yieldNil, false);
						auto* blocklit1 = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(static_cast<void*>(block1)), PyrParseNodeType::PushLitNode);
						auto* block2 = allocParseNode<PyrBlockNode>(@$, nullptr, nullptr, $4, false);
						auto* blocklit2 = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(static_cast<void*>(block2)), PyrParseNodeType::PushLitNode);

						auto* selectornode2 = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(getsym("if")));
						$$ = allocParseNode<PyrCallNode>(@$, selectornode2, linkNodes($3, blocklit2, blocklit1), nullptr);
					};

expr1			: pushliteral
				| blockliteral
				| generator
				| pushname
				| curryArg
				| msgsend
				| '(' exprseq ')'
					{
						PyrParseNode* node = $2;
						node->mParens = true; // This means  (((((1))))), will not count the brackets, but just indicates they exist.
						node->location = @$; // make the location include the brackets.
						$$ = $2;
					}
				| '~' name
					{
						auto* argnode = $2->changeLiteralType<PyrParseNodeType::PushLitNode>();
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_envirGet));
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, argnode, nullptr);
					}
				| '[' arrayelems ']'
					{ $$ = allocParseNode<PyrDynListNode>(@$, nullptr, $2); }
				| '(' valrange2 ')'
					{ $$ = $2; }
				|	'(' ':' valrange3 ')'
					{ $$ = $3; }
				|	'(' dictslotlist ')'
					{ $$ = allocParseNode<PyrDynDictNode>(@$, $2); }
				| expr1 '[' arglist1 ']'
					{
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_at));
						auto* args = linkNodes($1, $3);
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, args, nullptr);
					}
				| valrangex1;

valrangex1		: expr1 '[' arglist1 DOTDOT ']'
					{
