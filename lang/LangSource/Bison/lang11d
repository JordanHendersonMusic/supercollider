expr			: expr1
				| valrangexd
				| valrangeassign
				| CLASSNAME 
					{ $$ = $1->changeLiteralType<PyrParseNodeType::PushNameNode>(); }
				| expr '.' '[' arglist1 ']'
					{
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_at));
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, linkNodes($1, $4), nullptr);
					}
				| '`' expr
					{
						auto* args = linkNodes(
							allocParseNode<PyrSlotNode>(@1, PyrSlot::make(s_ref), PyrParseNodeType::PushNameNode),
							$2
						);
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_new));
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, args, nullptr);
					}
				| expr binop2 adverb expr %prec BINOP
					{
						$1->mNext = $4;
						$4->mNext = $3;
						$$ = allocParseNode<PyrBinopCallNode>(@$, $2, $1);
					}
				| name '=' expr
					{ $$ = allocParseNode<PyrAssignNode>(@$, $1, $3); }
				| '~' name '=' expr
					{
						auto* args = linkNodes($2->changeLiteralType<PyrParseNodeType::PushLitNode>(), $4);
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_envirPut));
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, args, nullptr);
					}
				| expr '.' name '=' expr
					{ $$ = allocParseNode<PyrSetterNode>(@$, $3, $1, $5); }
				| name '(' arglist1 optkeyarglist ')' '=' expr
					{
						if ($4 != nullptr) {
							printErrorLine(**getActiveCodePointStream(), $4->location, "Setter method called with keyword arguments");
							compileErrors++;
						}
						$$ = allocParseNode<PyrSetterNode>(@$, $1, $3, $7);
					}
				| '#' mavars '=' expr
					{ $$ = allocParseNode<PyrMultiAssignNode>(@$, $2, $4); }
				| expr1 '[' arglist1 ']' '=' expr
					{
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_put));
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, linkNodes($1, $3, $6), nullptr);
					}
				| expr '.' '[' arglist1 ']' '=' expr
					{
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_put));
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, linkNodes($1, $4, $7), nullptr);
					};

adverb  		: %empty  { $$ = nullptr; }
				| '.' name { $$ = $2->changeLiteralType<PyrParseNodeType::PushLitNode>(); }
				| '.' integer { $$ = $2->changeLiteralType<PyrParseNodeType::PushLitNode>(); }
				| '.' '(' exprseq ')' { $$ = $3; };

exprn			: expr
				| exprn ';' expr
					{ $$ = allocParseNode<PyrDropNode>(@$, $1, $3); } ;

exprseq 		: exprn optsemi;

arrayelems		: %empty { $$ = nullptr; }
				| arrayelems1 optcomma { $$ = $1; } ;

arrayelems1		: exprseq
				| exprseq ':' exprseq
					{ $$ = linkNodes($1, $3); }
				| KEYBINOP exprseq
					{ $$ = linkNodes( $1->changeLiteralType<PyrParseNodeType::PushLitNode>(), $2); }
				| arrayelems1 ',' exprseq
						{ $$ = linkNodes($1, $3); }
				| arrayelems1 ',' KEYBINOP exprseq
					{ $$ = linkNodes($1, $3->changeLiteralType<PyrParseNodeType::PushLitNode>(), $4); }
				| arrayelems1 ',' exprseq ':' exprseq
					{ $$ = linkNodes($1, $3, $5); };

arglist1		: exprseq
				| arglist1 ',' exprseq
					{ $$ = linkNodes($1, $3); };

arglistv1		: '*' exprseq
					{ @2 = @$; $$ = $2; }
				| arglist1 ',' '*' exprseq
						{ $$ = linkNodes($1, $4); };

keyarglist1		: keyarg
				| keyarglist1 ',' keyarg
						{ $$ = linkNodes($1, $3); };

keyarg			: KEYBINOP exprseq
					{ $$ = allocParseNode<PyrPushKeyArgNode>(@$, $1, $2); };

optkeyarglist	: optcomma { $$ = nullptr; }
				| ',' keyarglist1 optcomma { $$ = $2; };

mavars			: nameList
					{ $$ = allocParseNode<PyrMultiAssignVarListNode>(@$, $1, nullptr); }
				| nameList ELLIPSIS name
					{ $$ = allocParseNode<PyrMultiAssignVarListNode>(@$, $1, $3); };

nameList		: name 
				| nameList ',' name 
					{ $$ = linkNodes($1, $3); };

slotliteral 	: integer	{ $$ = $1->changeLiteralType<PyrParseNodeType::LiteralNode>(); }
				| floatp	{ $$ = $1->changeLiteralType<PyrParseNodeType::LiteralNode>(); }
				| ASCII		{ $$ = $1->changeLiteralType<PyrParseNodeType::LiteralNode>(); }
				| STRING	{ $$ = $1->changeLiteralType<PyrParseNodeType::LiteralNode>(); }
				| SYMBOL	{ $$ = $1->changeLiteralType<PyrParseNodeType::LiteralNode>(); }
				| TRUEOBJ	{ $$ = $1->changeLiteralType<PyrParseNodeType::LiteralNode>(); }
				| FALSEOBJ	{ $$ = $1->changeLiteralType<PyrParseNodeType::LiteralNode>(); }
				| NILOBJ	{ $$ = $1->changeLiteralType<PyrParseNodeType::LiteralNode>(); }
				| listlit	{ $$ = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(static_cast<void*>($1)), PyrParseNodeType::LiteralNode); };

blockliteral 	: block { $$ = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(static_cast<void*>($1)), PyrParseNodeType::PushLitNode); };

pushname		: name { $$ = $1->changeLiteralType<PyrParseNodeType::PushNameNode>(); };

pushliteral		: integer	{ $$ = $1->changeLiteralType<PyrParseNodeType::PushLitNode>(); }
				| floatp	{ $$ = $1->changeLiteralType<PyrParseNodeType::PushLitNode>(); }
				| ASCII		{ $$ = $1->changeLiteralType<PyrParseNodeType::PushLitNode>(); }
				| STRING	{ $$ = $1->changeLiteralType<PyrParseNodeType::PushLitNode>(); }
				| SYMBOL	{ $$ = $1->changeLiteralType<PyrParseNodeType::PushLitNode>(); }
				| TRUEOBJ	{ $$ = $1->changeLiteralType<PyrParseNodeType::PushLitNode>(); }
				| FALSEOBJ	{ $$ = $1->changeLiteralType<PyrParseNodeType::PushLitNode>(); }
				| NILOBJ	{ $$ = $1->changeLiteralType<PyrParseNodeType::PushLitNode>(); }
				| listlit	{ $$ = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(static_cast<void*>($1)), PyrParseNodeType::PushLitNode); };

listliteral		: integer	{ $$ = $1->changeLiteralType<PyrParseNodeType::LiteralNode>();}
				| floatp	{ $$ = $1->changeLiteralType<PyrParseNodeType::LiteralNode>(); }
				| ASCII		{ $$ = $1->changeLiteralType<PyrParseNodeType::LiteralNode>(); }
				| STRING	{ $$ = $1->changeLiteralType<PyrParseNodeType::LiteralNode>(); }
				| SYMBOL	{ $$ = $1->changeLiteralType<PyrParseNodeType::LiteralNode>(); }
				| name		{ $$ = $1->changeLiteralType<PyrParseNodeType::LiteralNode>(); }
				| TRUEOBJ	{ $$ = $1->changeLiteralType<PyrParseNodeType::LiteralNode>(); }
				| FALSEOBJ	{ $$ = $1->changeLiteralType<PyrParseNodeType::LiteralNode>(); }
				| NILOBJ	{ $$ = $1->changeLiteralType<PyrParseNodeType::LiteralNode>(); }
				| listlit2	{ $$ = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(static_cast<void*>($1)), PyrParseNodeType::LiteralNode); }

block			: '{' argdecls funcvardecls funcbody '}' 
					{ $$ = allocParseNode<PyrBlockNode>(@$, $2, $3, $4, false); }
				| BEGINCLOSEDFUNC argdecls funcvardecls funcbody '}' 
					{ $$ = allocParseNode<PyrBlockNode>(@$, $2, $3, $4, true); }
				;

funcvardecls	: %empty { $$ = nullptr; }
				| funcvardecls funcvardecl
					{ $$ = linkNodes($1, $2); };

funcvardecls1	: funcvardecl
				| funcvardecls1 funcvardecl
					{ $$ = linkNodes($1, $2); };

funcvardecl		: VAR vardeflist ';'
					{ $$ = allocParseNode<PyrVarListNode>(@$, $2, varLocal); };

argdecls		: %empty { $$ = nullptr; }
				| ARG vardeflist ';'
					{ $$ = allocParseNode<PyrArgListNode>(@$, $2, nullptr, nullptr); }
				| ARG vardeflist0 ELLIPSIS name ';'
					{ $$ = allocParseNode<PyrArgListNode>(@$, $2, $4, nullptr); }
				| ARG vardeflist0 ELLIPSIS name ',' name ';'
					{ $$ = allocParseNode<PyrArgListNode>(@$, $2, $4, $6); }
				| '|' slotdeflist '|'
					{ $$ = allocParseNode<PyrArgListNode>(@$, $2, nullptr, nullptr); }
				| '|' slotdeflist0 ELLIPSIS name '|'
					{ $$ = allocParseNode<PyrArgListNode>(@$, $2, $4, nullptr); }
				| '|' slotdeflist0 ELLIPSIS name ',' name '|'
				    { $$ = allocParseNode<PyrArgListNode>(@$, $2, $4, $6); };

argdecls1		: ARG vardeflist ';'
					{ $$ = allocParseNode<PyrArgListNode>(@$, $2, nullptr, nullptr); }
				| ARG vardeflist0 ELLIPSIS name ';'
					{ $$ = allocParseNode<PyrArgListNode>(@$, $2, $4, nullptr); }
				| ARG vardeflist0 ELLIPSIS name ',' name ';'
					{ $$ = allocParseNode<PyrArgListNode>(@$, $2, $4, $6); }
				| '|' slotdeflist '|'
					{ $$ = allocParseNode<PyrArgListNode>(@$, $2, nullptr, nullptr); }
				| '|' slotdeflist0 ELLIPSIS name '|'
					{ $$ = allocParseNode<PyrArgListNode>(@$, $2, $4, nullptr); }
				| '|' slotdeflist0 ELLIPSIS name ',' name '|'
				    { $$ = allocParseNode<PyrArgListNode>(@$, $2, $4, $6); };

constdeflist	: constdef
				| constdeflist optcomma constdef
					{ $$ = linkNodes($1, $3); } ;

constdef		: rspec name '=' slotliteral
					{ $$ = allocParseNode<PyrVarDefNode>(@$, $2, $4, $1); };

slotdeflist0 	: %empty { $$ = nullptr; }
				| slotdeflist;

slotdeflist		: slotdef
				| slotdeflist optcomma slotdef
					{ $$ = linkNodes($1, $3); };

slotdef			: name
					{ $$ = allocParseNode<PyrVarDefNode>(@$, $1, nullptr, ReadWriteAccessor::Private); }
				| name optequal slotliteral
					{ $$ = allocParseNode<PyrVarDefNode>(@$, $1, $3, ReadWriteAccessor::Private); }
				| name optequal '(' exprseq ')'
					{
						PyrParseNode* node = $4;
						node->mParens = 1;
						$$ = allocParseNode<PyrVarDefNode>(@$, $1, node, ReadWriteAccessor::Private);
					};

vardeflist0 	: %empty  { $$ = nullptr; }
				| vardeflist;

vardeflist      : vardef
				| vardeflist ',' vardef
					{ $$ = linkNodes($1, $3); };

vardef          : name
					{ $$ = allocParseNode<PyrVarDefNode>(@$, $1, nullptr, ReadWriteAccessor::Private); }
				| name '=' expr
					{ $$ = allocParseNode<PyrVarDefNode>(@$, $1, $3, ReadWriteAccessor::Private); }
				| name '(' exprseq ')'
					{
						PyrParseNode* node = $3;
						node->mParens = 1;
						$$ = allocParseNode<PyrVarDefNode>(@$, $1, node, ReadWriteAccessor::Private);
					};

dictslotdef		: exprseq ':' exprseq
					{ $$ = linkNodes($1, $3); }
				| KEYBINOP exprseq
					{ $$ = linkNodes($1->changeLiteralType<PyrParseNodeType::PushLitNode>(), $2); }
				;

dictslotlist1	: dictslotdef
				| dictslotlist1 ',' dictslotdef
					{ $$ = linkNodes($1, $3); } ;

dictslotlist	: %empty { $$ = nullptr; }
				| dictslotlist1 optcomma ;

rwslotdeflist	: rwslotdef
				| rwslotdeflist ',' rwslotdef
					{ $$ = linkNodes($1, $3); };

rwslotdef		: rwspec name
					{ $$ = allocParseNode<PyrVarDefNode>(@$, $2, nullptr, $1); }
				| rwspec name '=' slotliteral
					{ $$ = allocParseNode<PyrVarDefNode>(@$, $2, $4, $1); };

listlit			: '#' '[' literallistc ']'
					{ $$ = allocParseNode<PyrLitListNode>(@$, nullptr, $3); }
				| '#' CLASSNAME  '[' literallistc ']'
						{ $$ = allocParseNode<PyrLitListNode>(@$, $2, $4); };

listlit2		: '[' literallistc ']'
					{ $$ = allocParseNode<PyrLitListNode>(@$, nullptr, $2); }
				| CLASSNAME  '[' literallistc ']'
					{ $$ = allocParseNode<PyrLitListNode>(@$, $1, $3); };

literallistc	: %empty { $$ = nullptr; }
				| literallist1 optcomma;

literallist1	: listliteral
				| literallist1 ',' listliteral
					{ $$ = linkNodes($1, $3); };

rwspec			:  %empty { $$ = ReadWriteAccessor::Private; }
				| '<' { $$ = ReadWriteAccessor::Read; }
				| READWRITEVAR { $$ = ReadWriteAccessor::ReadWrite; }
				| '>' { $$ = ReadWriteAccessor::Write; };

rspec			: %empty { $$ = ReadWriteAccessor::Private; } 
				| '<' { $$ = ReadWriteAccessor::Read; };

integer			: INTEGER 
				| '-' INTEGER %prec UMINUS 
					{
						const auto v = $2->mSlot.getInt();
						$2->mSlot = PyrSlot::make(-v);
						$$ = $2;
					};

floatr			: SC_FLOAT 
				| '-' SC_FLOAT %prec UMINUS 
					{
						const double v = $2->mSlot.getDouble();
						$2->mSlot = PyrSlot::make(-v);
						$$ = $2;
					};

accidental 		: ACCIDENTAL 
				| '-' ACCIDENTAL %prec UMINUS 
					{
						const double in = $2->mSlot.getDouble();
						const double intval = floor(in + 0.5);
						const double fracval = in - intval;
						$2->mSlot = PyrSlot::make(-intval + fracval);
						$$ = $2;
					};

floatp			: floatr
				| accidental
				| floatr PIE 
					{
						$1->mSlot = PyrSlot::make($1->mSlot.getDouble() * pi);
						$1->location = @$;
						$$ = $1;
					}
				| integer PIE 
					{
						$1->mSlot = PyrSlot::make($1->mSlot.getInt() * pi);
						$1->location = @$;
						$$ = $1;
					}
				| PIE 
				| '-' PIE 
					{
						$2->mSlot = PyrSlot::make(-pi);
						$2->location = @$;
						$$ = $2;
					};

name 			: NAME | WHILE;
binop 			: BINOP | READWRITEVAR | '<' | '>' | '-' | '*' | '+' | '|';
binop2  		: binop | KEYBINOP;
curryArg 		: CURRYARG { $$ = allocParseNode<PyrCurryArgNode>(@$); }
