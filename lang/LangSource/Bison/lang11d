valrange2		: exprseq DOTDOT
					{
						// if this is not used in a 'do' or list comprehension, then should return an error.
						auto* args = linkNodes($1, allocParseNode<PyrSlotNode>(@2, PyrSlot{}, PyrParseNodeType::PushLitNode));
						args = linkNodes(args, allocParseNode<PyrSlotNode>(@2, PyrSlot{}, PyrParseNodeType::PushLitNode));
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_series));
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, args, nullptr);
					}
				| DOTDOT exprseq
					{
						auto* args = linkNodes(
							allocParseNode<PyrSlotNode>(@1, PyrSlot::make(0), PyrParseNodeType::PushLitNode),
							allocParseNode<PyrSlotNode>(@1, PyrSlot{}, PyrParseNodeType::PushLitNode),
							$2
						);
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_series));
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, args, nullptr);
					}
				| exprseq DOTDOT exprseq
					{
						auto* args = linkNodes($1, allocParseNode<PyrSlotNode>(@$, PyrSlot{}, PyrParseNodeType::PushLitNode), $3);
						auto* selectornode = allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_series));
						$$ = allocParseNode<PyrCallNode>(@$, selectornode, args, nullptr);
					}
				| exprseq ',' exprseq DOTDOT exprseq
