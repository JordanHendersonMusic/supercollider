  126                      | PIPE argument_declarations.pipelist ELLIPSIS name PIPE
  127                      | PIPE argument_declarations.pipelist ELLIPSIS name COMMA name PIPE
  128                      | PIPE ELLIPSIS name PIPE
  129                      | PIPE ELLIPSIS name COMMA name PIPE

  130 argument_declarations.opt: ε
  131                          | argument_declarations

  132 variable_declarations.list.item: name
  133                                | name EQUALSSIGN expr
