Grammar

    0 $accept: go $end

    1 go: INTERPRET region semicolon.opt
    2   | classOrExtList.list

    3 region: expr.error
    4       | region SEMICOLON expr.error
    5       | region error
    6       | region REGION_SEPARATOR expr.error

    7 expr.error: expr
    8           | error

    9 classOrExtList.list: classOrExtList.item
   10                    | classOrExtList.list classOrExtList.item

   11 classOrExtList.item: class
   12                    | class.extension

   13 class: CLASSNAME class.slot.opt class.super.opt OPENCURLY class.vars.opt method.list.opt CLOSECURLY

   14 class.super.opt: ε
   15                | COLON CLASSNAME

   16 class.slot.opt: ε
   17               | OPENSQUARE name CLOSESQUARE

   18 class.extension: ADD CLASSNAME OPENCURLY method.list.opt CLOSECURLY

   19 class.vars.entry.item: accessor variable_declarations.list.item

   20 class.vars.entry.list: class.vars.entry.item
   21                      | class.vars.entry.list COMMA class.vars.entry.item

   22 class.vars.entry: CLASSVAR class.vars.entry.list
   23                 | VAR class.vars.entry.list
   24                 | CONST class.vars.entry.list

   25 class.vars: class.vars.entry
   26           | class.vars SEMICOLON class.vars.entry

   27 class.vars.opt: ε
   28               | class.vars semicolon.opt

   29 method.name: name
   30            | binary_op.raw

   31 method.base: method.name OPENCURLY argument_declarations.opt block.contents semicolon.opt CLOSECURLY
   32            | method.name OPENCURLY argument_declarations.opt CLOSECURLY
   33            | method.name OPENCURLY argument_declarations.opt PRIMITIVENAME block.contents semicolon.opt CLOSECURLY
   34            | method.name OPENCURLY argument_declarations.opt PRIMITIVENAME CLOSECURLY

   35 method: method.base
   36       | MULTIPLY method.base

   37 method.list: method
   38            | method.list method

   39 method.list.opt: ε
   40                | method.list

   41 block.open: OPENCURLY
   42           | BEGINCLOSEDFUNC

   43 block: block.open argument_declarations.opt block.contents semicolon.opt CLOSECURLY
   44      | block.open argument_declarations.opt CLOSECURLY

   45 block.opt_list: ε
   46               | block.list

   47 block.list: block
   48           | block.list block

   49 block.contents: block.contents.item
   50               | block.contents SEMICOLON block.contents.item

   51 block.contents.item: expr
   52                    | variable_declarations
   53                    | NONLOCALRETURN expr

   54 msgsend: OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN arguments CLOSEPAREN block.opt_list
   55        | OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN CLOSEPAREN block.list
   56        | OPENPAREN binary_op.no_adverb CLOSEPAREN block.list
   57        | name OPENPAREN arguments CLOSEPAREN block.opt_list
   58        | name OPENPAREN CLOSEPAREN block.list
   59        | name block.list
   60        | expr DOT name arguments.maybe_paren block.opt_list
   61        | expr DOT arguments.paren block.opt_list
   62        | expr DOT OPENPAREN CLOSEPAREN block.opt_list
   63        | expr DOT error
   64        | CLASSNAME OPENSQUARE literal.array.contents CLOSESQUARE
   65        | CLASSNAME block.list
   66        | CLASSNAME OPENPAREN arguments CLOSEPAREN block.opt_list
   67        | CLASSNAME OPENPAREN CLOSEPAREN block.opt_list

   68 expr.base: literal
   69          | name
   70          | msgsend
   71          | OPENPAREN expr.seq CLOSEPAREN
   72          | TILDE name
   73          | expr.base OPENSQUARE arguments CLOSESQUARE
   74          | expr.base OPENSQUARE CLOSESQUARE

   75 expr: expr.base
   76     | CLASSNAME
   77     | expr DOT OPENSQUARE arguments CLOSESQUARE
   78     | expr DOT OPENSQUARE CLOSESQUARE
   79     | BACKTICK expr
   80     | expr binary_op expr
   81     | name EQUALSSIGN expr
   82     | TILDE name EQUALSSIGN expr
   83     | expr DOT name EQUALSSIGN expr
   84     | name OPENPAREN arguments CLOSEPAREN EQUALSSIGN expr
   85     | expr.base OPENSQUARE arguments CLOSESQUARE EQUALSSIGN expr
   86     | expr.base OPENSQUARE CLOSESQUARE EQUALSSIGN expr
   87     | expr DOT OPENSQUARE arguments CLOSESQUARE EQUALSSIGN expr
   88     | expr DOT OPENSQUARE CLOSESQUARE EQUALSSIGN expr

   89 expr.seq.base: expr
   90              | expr.seq.base SEMICOLON expr

   91 expr.seq: expr.seq.base semicolon.opt

   92 adverb: DOT name
   93       | DOT integer
   94       | DOT OPENPAREN expr.seq CLOSEPAREN

   95 argument_declarations.list: name
   96                           | name EQUALSSIGN literal
   97                           | name OPENPAREN expr.seq CLOSEPAREN
   98                           | name EQUALSSIGN OPENPAREN expr.seq CLOSEPAREN
   99                           | argument_declarations.list COMMA name
  100                           | argument_declarations.list COMMA name EQUALSSIGN literal
  101                           | argument_declarations.list COMMA name OPENPAREN expr.seq CLOSEPAREN
  102                           | argument_declarations.list COMMA name EQUALSSIGN OPENPAREN expr.seq CLOSEPAREN

  103 argument_declarations.pipelist: name literal
  104                               | name
  105                               | name EQUALSSIGN literal
  106                               | name OPENPAREN expr.seq CLOSEPAREN
  107                               | name EQUALSSIGN OPENPAREN expr.seq CLOSEPAREN
  108                               | argument_declarations.pipelist comma.opt name literal
  109                               | argument_declarations.pipelist comma.opt name
  110                               | argument_declarations.pipelist comma.opt name EQUALSSIGN literal
  111                               | argument_declarations.pipelist comma.opt name OPENPAREN expr.seq CLOSEPAREN
  112                               | argument_declarations.pipelist comma.opt name EQUALSSIGN OPENPAREN expr.seq CLOSEPAREN

  113 argument_declarations: ARG SEMICOLON
  114                      | ARG argument_declarations.list comma.opt SEMICOLON
  115                      | ARG argument_declarations.list ELLIPSIS name SEMICOLON
  116                      | ARG argument_declarations.list ELLIPSIS name COMMA name SEMICOLON
  117                      | PIPE PIPE
  118                      | PIPE argument_declarations.pipelist comma.opt PIPE
  119                      | PIPE argument_declarations.pipelist ELLIPSIS name PIPE
  120                      | PIPE argument_declarations.pipelist ELLIPSIS name COMMA name PIPE

  121 argument_declarations.opt: ε
  122                          | argument_declarations

  123 variable_declarations.list.item: name
  124                                | name EQUALSSIGN expr
  125                                | name OPENPAREN expr.seq CLOSEPAREN

  126 variable_declarations.list: variable_declarations.list.item
  127                           | variable_declarations.list COMMA variable_declarations.list.item

  128 variable_declarations: VAR variable_declarations.list comma.opt

  129 arguments.entries: KEYBINOP expr.seq
  130                  | MULTIPLY expr.seq
  131                  | expr.seq

  132 arguments.no_trailing: arguments.entries
  133                      | arguments.no_trailing COMMA arguments.entries

  134 arguments: arguments.no_trailing comma.opt

  135 arguments.paren: OPENPAREN arguments CLOSEPAREN

  136 arguments.maybe_paren: ε
  137                      | arguments.paren

  138 literal.terminal: symbol
  139                 | string
  140                 | integer
  141                 | float
  142                 | boolean
  143                 | nil
  144                 | ascii
  145                 | block

  146 literal.array.contents: ε
  147                       | expr.seq
  148                       | expr.seq COLON expr.seq
  149                       | KEYBINOP expr.seq
  150                       | literal.array.contents COMMA expr.seq
  151                       | literal.array.contents COMMA expr.seq COLON expr.seq
  152                       | literal.array.contents COMMA KEYBINOP expr.seq

  153 literal.dictionary.entry: expr.seq COLON expr.seq
  154                         | KEYBINOP expr.seq

  155 literal.dictionary.entries: ε
  156                           | literal.dictionary.entry
  157                           | literal.dictionary.entries COMMA literal.dictionary.entry

  158 literal.dictionary: OPENPAREN literal.dictionary.entries comma.opt CLOSEPAREN

  159 literal.array: OPENSQUARE literal.array.contents comma.opt CLOSESQUARE
  160              | HASH OPENSQUARE literal.array.contents comma.opt CLOSESQUARE

  161 literal: literal.terminal
  162        | literal.array
  163        | literal.dictionary

  164 name: NAME

  165 binary_op.raw: BINOP
  166              | READWRITEVAR
  167              | LESSTHAN
  168              | GREATERTHAN
  169              | MINUS
  170              | MULTIPLY
  171              | ADD
  172              | PIPE

  173 binary_op.no_adverb: binary_op.raw
  174                    | KEYBINOP

  175 binary_op: binary_op.no_adverb adverb
  176          | binary_op.no_adverb

  177 semicolon.opt: ε
  178              | SEMICOLON

  179 comma.opt: ε
  180          | COMMA

  181 ascii: ASCII

  182 nil: NIL

  183 boolean: TRUE
  184        | FALSE

  185 symbol: SYMBOL_QUOTE
  186       | SYMBOL_SLASH

  187 string: STRINGLINE
  188       | string STRINGLINE

  189 integer: INTEGER
  190        | INTEGER_RADIX
  191        | HEXADECIMAL
  192        | MINUS integer

  193 float.raw_unsigned: FLOAT
  194                   | FLOAT_RADIX
  195                   | FLOAT_EXPONENT
  196                   | FLOAT_INF

  197 float.raw: float.raw_unsigned
  198          | MINUS float.raw_unsigned

  199 accidental.unsigned: ACCIDENTAL_STEPS
  200                    | ACCIDENTAL_CENTS

  201 accidental: accidental.unsigned
  202           | MINUS accidental.unsigned

  203 float: float.raw
  204      | accidental
  205      | float.raw PI
  206      | integer PI
  207      | PI
  208      | MINUS PI

  209 accessor: ε
  210         | LESSTHAN
  211         | READWRITEVAR
  212         | GREATERTHAN


