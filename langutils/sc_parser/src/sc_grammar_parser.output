Grammar

    0 $accept: go $end

    1 go: region $end
    2   | classOrExtList.list $end

    3 region.item: expr
    4            | OPENPAREN argument_declarations block.contents CLOSEPAREN
    5            | OPENPAREN argument_declarations CLOSEPAREN

    6 region: INTERPRET expr
    7       | INTERPRET error
    8       | INTERPRET OPENPAREN argument_declarations block.contents semicolon.opt CLOSEPAREN
    9       | INTERPRET OPENPAREN argument_declarations CLOSEPAREN
   10       | region SEMICOLON region.item
   11       | region REGION_SEPARATOR region.item
   12       | region error

   13 classOrExtList.list: classOrExtList.item
   14                    | classOrExtList.list classOrExtList.item

   15 classOrExtList.item: class
   16                    | class.extension

   17 class: CLASSNAME class.slot.opt class.super.opt OPENCURLY class.vars.opt method.list.opt CLOSECURLY

   18 class.super.opt: ε
   19                | COLON CLASSNAME

   20 class.slot.opt: ε
   21               | OPENSQUARE name CLOSESQUARE

   22 class.extension: ADD CLASSNAME OPENCURLY method.list.opt CLOSECURLY

   23 class.vars.entry.item: accessor variable_declarations.list.item

   24 class.vars.entry.list: class.vars.entry.item
   25                      | class.vars.entry.list COMMA class.vars.entry.item

   26 class.vars.entry: CLASSVAR class.vars.entry.list
   27                 | VAR class.vars.entry.list
   28                 | CONST class.vars.entry.list

   29 class.vars: class.vars.entry
   30           | class.vars SEMICOLON class.vars.entry

   31 class.vars.opt: ε
   32               | class.vars semicolon.opt

   33 method.name: name
   34            | binary_op.raw

   35 method.base: method.name OPENCURLY argument_declarations.opt block.contents semicolon.opt CLOSECURLY
   36            | method.name OPENCURLY argument_declarations.opt CLOSECURLY
   37            | method.name OPENCURLY argument_declarations.opt PRIMITIVENAME semicolon.opt block.contents semicolon.opt CLOSECURLY
   38            | method.name OPENCURLY argument_declarations.opt PRIMITIVENAME semicolon.opt CLOSECURLY

   39 method: method.base
   40       | MULTIPLY method.base

   41 method.list: method
   42            | method.list method

   43 method.list.opt: ε
   44                | method.list

   45 block.open: OPENCURLY
   46           | BEGINCLOSEDFUNC

   47 block: block.open argument_declarations.opt block.contents semicolon.opt CLOSECURLY
   48      | block.open argument_declarations.opt CLOSECURLY

   49 block.opt_list: ε
   50               | block.list

   51 block.list: block
   52           | block.list block

   53 block.contents.no_trailing_return: block.contents.item
   54                                  | block.contents SEMICOLON block.contents.item

   55 block.contents: block.contents.no_trailing_return
   56               | block.contents.no_trailing_return NONLOCALRETURN expr

   57 block.contents.item: expr
   58                    | variable_declarations
   59                    | NONLOCALRETURN expr

   60 msgsend: OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN arguments CLOSEPAREN block.opt_list
   61        | OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN CLOSEPAREN block.list
   62        | OPENPAREN binary_op.no_adverb CLOSEPAREN block.list
   63        | name OPENPAREN arguments CLOSEPAREN block.opt_list
   64        | name OPENPAREN CLOSEPAREN block.list
   65        | name block.list
   66        | expr DOT name arguments.maybe_paren block.opt_list
   67        | expr DOT arguments.paren block.opt_list
   68        | expr DOT OPENPAREN CLOSEPAREN block.opt_list
   69        | CLASSNAME OPENSQUARE literal.array.contents CLOSESQUARE
   70        | CLASSNAME block.list
   71        | CLASSNAME OPENPAREN arguments CLOSEPAREN block.opt_list
   72        | CLASSNAME OPENPAREN CLOSEPAREN block.opt_list

   73 expr.base: literal
   74          | name
   75          | msgsend
   76          | OPENPAREN block.contents semicolon.opt CLOSEPAREN
   77          | TILDE name
   78          | expr.base OPENSQUARE arguments CLOSESQUARE
   79          | expr.base OPENSQUARE CLOSESQUARE

   80 expr: expr.base
   81     | CLASSNAME
   82     | expr DOT OPENSQUARE arguments CLOSESQUARE
   83     | expr DOT OPENSQUARE CLOSESQUARE
   84     | BACKTICK expr
   85     | expr binary_op expr
   86     | name EQUALSSIGN expr
   87     | TILDE name EQUALSSIGN expr
   88     | expr DOT name EQUALSSIGN expr
   89     | name OPENPAREN arguments CLOSEPAREN EQUALSSIGN expr
