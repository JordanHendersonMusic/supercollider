  185          | binary_op.no_adverb

  186 semicolon.opt: ε
  187              | SEMICOLON

  188 comma.opt: ε
  189          | COMMA

  190 ascii: ASCII

  191 nil: NIL

  192 boolean: TRUE
  193        | FALSE

  194 symbol: SYMBOL_QUOTE
