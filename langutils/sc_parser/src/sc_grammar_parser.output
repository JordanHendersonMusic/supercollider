   38            | method.name OPENCURLY argument_declarations.opt PRIMITIVENAME CLOSECURLY

   39 method: method.base
   40       | MULTIPLY method.base

   41 method.list: method
   42            | method.list method

   43 method.list.opt: ε
   44                | method.list

   45 block.open: OPENCURLY
   46           | BEGINCLOSEDFUNC

   47 block: block.open argument_declarations.opt block.contents semicolon.opt CLOSECURLY
   48      | block.open argument_declarations.opt CLOSECURLY

   49 block.opt_list: ε
   50               | block.list

   51 block.list: block
   52           | block.list block

   53 block.contents: block.contents.item
   54               | block.contents SEMICOLON block.contents.item

   55 block.contents.item: expr
   56                    | variable_declarations
   57                    | NONLOCALRETURN expr

   58 msgsend: OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN arguments CLOSEPAREN block.opt_list
   59        | OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN CLOSEPAREN block.list
   60        | OPENPAREN binary_op.no_adverb CLOSEPAREN block.list
   61        | name OPENPAREN arguments CLOSEPAREN block.opt_list
   62        | name OPENPAREN CLOSEPAREN block.list
   63        | name block.list
   64        | expr DOT name arguments.maybe_paren block.opt_list
   65        | expr DOT arguments.paren block.opt_list
   66        | expr DOT OPENPAREN CLOSEPAREN block.opt_list
