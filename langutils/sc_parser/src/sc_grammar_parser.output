  135                  | expr.seq

  136 arguments.no_trailing: arguments.entries
  137                      | arguments.no_trailing COMMA arguments.entries

  138 arguments: arguments.no_trailing comma.opt

  139 arguments.paren: OPENPAREN arguments CLOSEPAREN

  140 arguments.maybe_paren: ε
