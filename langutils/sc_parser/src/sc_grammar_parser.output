  135 variable_declarations.list: variable_declarations.list.item
  136                           | variable_declarations.list COMMA variable_declarations.list.item

  137 variable_declarations: VAR variable_declarations.list

  138 arguments.entries: KEYBINOP expr.seq
  139                  | MULTIPLY expr.seq
  140                  | expr.seq

  141 arguments.no_trailing: arguments.entries
  142                      | arguments.no_trailing COMMA arguments.entries

  143 arguments: arguments.no_trailing comma.opt

  144 arguments.paren: OPENPAREN arguments CLOSEPAREN

  145 arguments.maybe_paren: ε
  146                      | arguments.paren

  147 literal.terminal: symbol
  148                 | string
  149                 | integer
  150                 | float
  151                 | boolean
  152                 | nil
  153                 | ascii
  154                 | block

  155 literal.array.contents: ε
  156                       | expr.seq
  157                       | expr.seq COLON expr.seq
  158                       | KEYBINOP expr.seq
  159                       | literal.array.contents COMMA expr.seq
  160                       | literal.array.contents COMMA expr.seq COLON expr.seq
  161                       | literal.array.contents COMMA KEYBINOP expr.seq

  162 literal.dictionary.entry: expr COLON expr.seq
  163                         | KEYBINOP expr.seq

  164 literal.dictionary.entries: ε
  165                           | literal.dictionary.entry
  166                           | literal.dictionary.entries COMMA literal.dictionary.entry

  167 literal.dictionary: OPENPAREN literal.dictionary.entries comma.opt CLOSEPAREN

  168 literal.array: OPENSQUARE literal.array.contents comma.opt CLOSESQUARE
  169              | HASH OPENSQUARE literal.array.contents comma.opt CLOSESQUARE

  170 literal: literal.terminal
  171        | literal.array
  172        | literal.dictionary

  173 name: NAME

  174 binary_op.raw: BINOP
