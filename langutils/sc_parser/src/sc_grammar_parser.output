   58               | NONLOCALRETURN expr

   59 block.contents.item: expr
   60                    | variable_declarations

   61 msgsend: OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN arguments CLOSEPAREN block.opt_list
   62        | OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN CLOSEPAREN block.list
   63        | OPENPAREN binary_op.no_adverb CLOSEPAREN block.list
   64        | name OPENPAREN arguments CLOSEPAREN block.opt_list
