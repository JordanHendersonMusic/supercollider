   92     | expr DOT OPENSQUARE arguments CLOSESQUARE EQUALSSIGN expr
   93     | expr DOT OPENSQUARE CLOSESQUARE EQUALSSIGN expr

   94 expr.seq.base: expr
   95              | expr.seq.base SEMICOLON expr

   96 expr.seq: expr.seq.base semicolon.opt

   97 adverb: DOT name
   98       | DOT integer
   99       | DOT OPENPAREN expr.seq CLOSEPAREN

  100 argument_declarations.list: name
